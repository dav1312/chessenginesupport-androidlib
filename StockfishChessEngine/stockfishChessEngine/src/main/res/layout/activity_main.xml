<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#1b1b1f">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Stockfish Logo -->
        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="Stockfish Logo"
            android:src="@drawable/ic_launcher" />

        <!-- Engine Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stockfish"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#43ad6a"
            android:layout_marginBottom="4dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Strong open-source chess engine"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"
            android:gravity="center" />

        <!-- Informational Explanation Text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This application is a backend chess engine and does not contain a playable graphical user interface (GUI).\n\nTo play against Stockfish or analyze games, you must install a separate Chess GUI application, then select Stockfish inside that application's settings."
            android:textSize="15sp"
            android:textColor="#CCCCCC"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="32dp" />

        <!-- Section 1: Chess GUIs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Download a Compatible Chess GUI"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center_horizontal"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnChessis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Get Chessis (Google Play)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnDroidFish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Get DroidFish (F-Droid)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnWikiMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Other Compatible GUIs (Wiki)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Section 2: Latest Stockfish Releases -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Latest Stockfish Releases"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnRefreshReleases"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="Refresh"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:paddingLeft="12dp"
                    android:paddingTop="6dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/button_secondary"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressReleases"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="visible" />

            <TextView
                android:id="@+id/txtReleasesError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unable to load releases."
                android:textColor="#FF4D4D"
                android:textSize="14sp"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnRetryReleases"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Retry"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_secondary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <!-- Container for release items, dynamically filled -->
            <LinearLayout
                android:id="@+id/containerReleases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Section 3: Blog -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Blog"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnRefreshBlog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="Refresh"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:paddingLeft="12dp"
                    android:paddingTop="6dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/button_secondary"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBlog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="visible" />

            <TextView
                android:id="@+id/txtBlogError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unable to load blog posts."
                android:textColor="#FF4D4D"
                android:textSize="14sp"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnRetryBlog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Retry"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_secondary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <!-- Container for blog items, dynamically filled -->
            <LinearLayout
                android:id="@+id/containerBlog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Section 4: Resources & Socials -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Official Resources &amp; Socials"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center_horizontal"
                android:layout_marginBottom="16dp" />

            <!-- Row 1: Docs & License -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <Button
                    android:id="@+id/btnDocs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Docs"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:background="@drawable/button_secondary"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="5dp"/>
                <Button
                    android:id="@+id/btnLicense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="License (GPLv3)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:background="@drawable/button_secondary"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:layout_marginStart="5dp" />
            </LinearLayout>

            <!-- Row 2: Discord & GitHub -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <Button
                    android:id="@+id/btnDiscord"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Discord"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:background="@drawable/button_secondary"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="5dp"/>
                <Button
                    android:id="@+id/btnGitHub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GitHub"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:background="@drawable/button_secondary"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>

            <!-- Row 3: Bluesky & X (Twitter) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnBluesky"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bluesky"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:background="@drawable/button_secondary"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="5dp"/>
                <Button
                    android:id="@+id/btnTwitter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="X / Twitter"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:background="@drawable/button_secondary"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:layout_marginStart="5dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
