<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#1b1b1f">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Stockfish Logo -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/logo_bg" />

            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:contentDescription="Stockfish Logo"
                android:src="@drawable/ic_launcher" />
        </FrameLayout>

        <!-- Engine Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stockfish"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#43ad6a"
            android:layout_marginBottom="4dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Strong open-source chess engine"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"
            android:gravity="center" />

        <!-- Informational Explanation Text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This application is a backend chess engine and does not contain a playable graphical user interface (GUI).\n\nTo play against Stockfish or analyze games, you must install a separate Chess GUI application, then select Stockfish inside that application's settings."
            android:textSize="14sp"
            android:textColor="#CCCCCC"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="32dp" />

        <!-- Section 1: Chess GUIs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Download a Compatible Chess GUI"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center_horizontal"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnChessis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Get Chessis (Google Play)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnDroidFish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Get DroidFish (F-Droid)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnWikiMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Other Compatible GUIs (Wiki)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Section 2: Official Links -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Official Stockfish Resources"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center_horizontal"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnDocs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Documentation"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/button_secondary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnDiscord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Join Discord Server"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/button_secondary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnLicense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View License (GPLv3)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/button_secondary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
